{
  "name": "podarcis",
  "displayName": "Podarcis",
  "description": "Set up a Podarcis research vault: Git repositories for sources, wiki, and workspace, agent targets, and recommended MCP servers.",
  "version": "1.0.0",
  "publisher": "xicu",
  "license": "AGPL-3.0",
  "repository": { "type": "git", "url": "https://github.com/XicuM/Podarcis.git" },
  "engines": { "vscode": "^1.85.0" },
  "extensionKind": ["workspace"],
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "podarcis", "title": "Podarcis", "icon": "icon.svg" }]
    },
    "views": {
      "podarcis": [{ "type": "webview", "id": "podarcis.setup", "name": "Setup" }]
    },
    "configuration": {
      "title": "Podarcis",
      "properties": {
        "podarcis.uvCommand": {
          "type": "string",
          "default": "uv",
          "description": "Name or absolute path of uv."
        },
        "podarcis.skillPath": {
          "type": "string",
          "default": ".agents/skills/podarcis",
          "description": "Podarcis skill folder, relative to the workspace folder or absolute. Setup installs it at the default path."
        }
      }
    }
  }
}
