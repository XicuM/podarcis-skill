# Local runtime paths. This file contains no credentials.
# make setup copies it to .env only when .env does not already exist.
WORKSPACE_MCP_LOG_DIR=.local/google_drive/logs
WORKSPACE_MCP_CREDENTIALS_DIR=.local/google_drive/credentials
OVERLEAF_SESSION_FILE=.local/overleaf/session.json
PLAYWRIGHT_BROWSERS_PATH=.local/playwright

# Optional metadata/search keys:
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=

# Required for Google Drive's OAuth setup; enable Drive API in your GCP project.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Alternatively to npm run overleaf:login:
# OVERLEAF_SESSION_COOKIE=
